  <version>0.1.0</version>
  <description>ROS 1 C++ MAVROS adapter for the ESO-NMPC controller.</description>
  <maintainer email="cy@example.com">eso_nmpc</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
